<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Windows Authentication ile baglanmak icin asagidaki satirlardan birini aktif edin.
      Secim 1: Varsayilan SQL Server instance (localhost)
      Secim 2: SQLEXPRESS instance
      Secim 3: Sunucu adinizi yazin
    -->
    <add name="SinavTakipDB"
         connectionString="Server=AANENESIMEKE602\SQLEXPRESS04;Database=SinavTakip;Integrated Security=SSPI;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="YedekKlasor" value="C:\Yedekler" />
  </appSettings>
</configuration>
